{
    "extends": "@enterprise/typescript-config/nextjs.json",
    "compilerOptions": {
        "paths": {
            "@/*": [
                "./*"
            ],
            "@enterprise/ui/*": [
                "../../packages/ui/src/*"
            ]
        },
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": [
        "next-env.d.ts",
        "next.config.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
